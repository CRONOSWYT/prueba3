# ---------------------------------------------------------------------------
# SMART TEST — variables de entorno
# Copia este archivo a ".env" y rellena los valores correspondientes.
# En Codespaces / contenedores de desarrollo el fichero .devcontainer/docker-compose.yml
# ya inyecta valores de conexión locales (DB_HOST=db), por lo que no necesitas
# tocar nada. Este ".env.example" es solo de referencia.
# ---------------------------------------------------------------------------

# Host de la base de datos MySQL.
#  - Producción (Render/Aiven): smarttest-smartest.c.aivencloud.com
#  - Desarrollo local / Codespaces: db  (nombre del servicio en docker-compose)
DB_HOST=db

# Puerto de MySQL.
#  - Producción: 20038
#  - Desarrollo: 3306
DB_PORT=3306

# Nombre de la base de datos.
DB_NAME=smart_test

# Usuario de la base de datos.
DB_USER=smart

# Contraseña de la base de datos.
DB_PASSWORD=devpass

# ¿Forzar conexión cifrada (SSL) a la base de datos?
#  - Producción (Aiven): true  -> usa el certificado CA en php/certs/aiven-ca.pem
#  - Desarrollo local:    false -> la conexión local no usa SSL
DB_SSL=false
